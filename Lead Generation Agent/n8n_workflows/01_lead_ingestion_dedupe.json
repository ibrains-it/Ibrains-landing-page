{
  "name": "01_lead_ingestion_dedupe",
  "nodes": [
    {
      "parameters": { "path": "leads/ingest", "responseMode": "onReceived", "options": {} },
      "name": "Webhook Ingestion Node",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst domain = (item.website || '').replace(/^(?:https?:\\/\\/)?(?:www\\.)?/i, '').split('/')[0].split('?')[0].toLowerCase();\nreturn { json: { ...item, normalized_domain: domain } };"
      },
      "name": "Canonical Normalizer Node",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "table": "organizations_v2",
        "columnToMatchOn": "normalized_domain"
      },
      "name": "Supabase Organization Upsert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook Ingestion Node": { "main": [[{ "node": "Canonical Normalizer Node", "type": "main", "index": 0 }]] },
    "Canonical Normalizer Node": { "main": [[{ "node": "Supabase Organization Upsert", "type": "main", "index": 0 }]] }
  }
}
